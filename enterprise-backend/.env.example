# Property Searcher Enterprise Backend — Environment Variables Template
# Copy this file to .env and configure your values

# Telegram Bot Credentials
TELEGRAM_BOT_USERNAME=Property_Searcher_bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Database Configuration (PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/property_searcher
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_secure_password

# Engine Settings
TRACKER_DELAY_MS=120000
